{
  "name": "editor",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- next dev --port ${PORT:-3002}",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint",
    "check-types": "next typegen && tsgo --noEmit",
    "db:generate": "dotenv -e ../../.env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env.local -- node scripts/run-migration.mjs",
    "db:studio": "dotenv -e ../../.env.local -- drizzle-kit studio"
  },
