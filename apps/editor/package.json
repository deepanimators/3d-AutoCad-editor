    "@aruct/viewer": "*",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@iconify/react": "^6.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@number-flow/react": "^0.6.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/postcss": "^4.2.1",
    "clsx": "^2.1.1",
